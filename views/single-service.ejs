<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%=servico.nome%></title>
</head>
<body>
    <h1><%=servico.nome%></h1>
    <div class="horarios">
        <h2>Horários Disponíveis:</h2>
        <% if(servico.horarios.every(horario => horario.cliente != null)){%>
            <h3>Nenhum horário disponível para esse serviço!</h3>
        <%}%>

        <%servico.horarios.forEach(horario=>{%>
            <%if(horario.cliente == null){%>
                <div class="horario">
                    <p><%=horario.hora%></p>
                    <a href="/api/services/<%= servico.id %>/agendamento/<%= horario.id %>">Agende nesse horário</a> <!-- link completo para criar agendamento usando serviceId + horarioId -->
                </div>
            <%}%>
        <%})%>
    </div>
</body>
</html>
</body>
</html>