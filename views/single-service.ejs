<%- include(partials + '/header-selector.ejs')%>
    <h1><%=servico.nome%></h1>
    <div class="horarios">
        <h2>Horários Disponíveis:</h2>
        <% if(servico.horarios.every(horario => horario.isOcupado())){%>
            <h3>Nenhum horário disponível para esse serviço!</h3>
        <%}%>
        <%servico.horarios.forEach(horario=>{%>
            <%if(horario.ocupado == false){%>
                <div class="horario">
                    <p><%=horario.hora%></p>
                    <button id=<%= `${horario.id}`%> class="agendamentoButton">Agende nesse horário</button> <!-- fetch no js -->
                </div>
            <%}%>
        <%})%>
    </div>

    <script>
        const agendamentoButtons = document.querySelectorAll('button.agendamentoButton');
        
        function defineAgendamentoButtons(){
            agendamentoButtons.forEach(b => {
                const sid = b.getAttribute('id');
                if(!sid) return false; 

                b.onclick = ()=>{
                    fetch(`/servico/agendar/${sid}`,{method:'POST'}).then(res =>{
                        if(!res.ok) return res.json().then(details => console.log(details.error_message))
                        
                        return res.json();
                    }).then(details =>{
                        window.location.href = details.redirectTo;
                    })
                }
            })
        }
        defineAgendamentoButtons()
    </script>
</body>
</html>
