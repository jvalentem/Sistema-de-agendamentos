<%- include(partials + 'header-selector.ejs')%>

    <main class="admin-container">
        <aside class="admin-side-bar" aria-label="Navegação administrativa">
            <button type="button" id="b-servicos" data-section="servicos">Serviços</button>
            <button type="button" id="b-funcionarios" data-section="funcionarios">Funcionários</button>
            <button type="button" id="b-agendamentos" data-section="agendamentos">Histórico de agendamentos</button>
            <button type="button" id="b-clientes" data-section="clientes">Clientes</button>
        </aside>

        <section class="admin-content">
            <h1>Painel administrativo</h1>
            <p>Selecione uma seção para consultar os dados.</p>
        </section>
    </main>

    <div class="admin-modal-backdrop" id="admin-modal-backdrop" hidden>
        <section class="janela-flutuante admin-window" id="janela-flutuante" role="dialog" aria-modal="true" aria-labelledby="admin-window-title">
            <div class="admin-window-header">
                <h2 id="admin-window-title"></h2>
                <button type="button" class="admin-close" id="admin-close" aria-label="Fechar">&times;</button>
            </div>
            <div class="admin-list" id="admin-list" aria-live="polite"></div>
        </section>
    </div>

    <script>
        const secoesAdmin = {
            servicos: { title: 'Serviços', path: '/administrativo/servicos' },
            funcionarios: { title: 'Funcionários', path: '/administrativo/funcionarios' },
            agendamentos: { title: 'Histórico de agendamentos', path: '/administrativo/agendamentos' },
            clientes: { title: 'Clientes', path: '/administrativo/clientes' }
        };

        const modalBackdrop = document.getElementById('admin-modal-backdrop');
        const modalTitle = document.getElementById('admin-window-title');
        const adminList = document.getElementById('admin-list');

        function adicionarCampo(card, label, value, field = null, fieldValue = value) {
            if (!value || !card || !label) return;

            const row = document.createElement('p');
            const name = document.createElement('strong');
            const content = document.createElement('span');
            name.textContent = `${label}: `;
            content.textContent = String(value);
            if (field) {
                row.dataset.editableField = field;
                row.dataset.fieldValue = String(fieldValue ?? '');
            }
            row.append(name, content);
            card.appendChild(row);
        }

        function adicionarBotao(card, name, funct) {
            if (!funct || !name || !card) return;

            const botao = document.createElement('button');
            botao.textContent = name;
            botao.onclick = funct;
            card.appendChild(botao);
            return botao;
        }

        let funcionariosCache;

        async function carregarFuncionarios() {
            if (funcionariosCache) return funcionariosCache;

            //puxa os funcionarios do servidor
            const response = await fetch(secoesAdmin.funcionarios.path, { method: 'GET' });
            if (!response.ok) throw new Error('Não foi possível carregar os funcionários.');

            const funcionarios = await response.json();
            if (!Array.isArray(funcionarios)) throw new Error('A lista de funcionários recebida é inválida.');
            funcionariosCache = funcionarios;
            return funcionariosCache;
        }

        function criarCampoEdicao(row, field, funcionarios) {
            const input = document.createElement(field === 'funcionario' ? 'select' : 'input');
            const value = row.dataset.fieldValue;

            if (field === 'funcionario') {
                funcionarios.forEach(funcionario => {
                    const option = document.createElement('option');
                    option.value = String(funcionario.id);
                    option.textContent = funcionario.nome;
                    option.selected = String(funcionario.id) === value;
                    input.appendChild(option);
                });
            } else {
                input.type = field === 'preco' || field === 'duracao' ? 'number' : 'text';
                input.value = value;
                input.required = true;
                if (field === 'preco') input.min = '0';
                if (field === 'duracao') {
                    input.min = '1';
                    input.step = '1';
                }
            }

            if (field === 'funcionario') input.required = true;
            input.name = field;
            input.setAttribute('aria-label', row.querySelector('strong').textContent.replace(': ', ''));
            return input;
        }

        async function concluirEdicaoServico(card, serviceId) {
            const dataCluster = {};

            //Variavel importante para alterar os valores na hora que o usuario concluir a edição
            
            const fieldsToUpdate = [];

            for (const row of card.querySelectorAll('[data-editable-field]')) {
                const field = row.dataset.editableField;
                const input = row.querySelector('input, select');

                if (!input || !input.reportValidity()) return false;

                dataCluster[field] = input.value;
                
                fieldsToUpdate.push({ row, field, input });
            }
            console.log('DATACLUSTER:', dataCluster)
            const response = await fetch(`/servico/editar/${serviceId}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dataCluster)
            });
            if (!response.ok) {
                throw new Error('Não foi possível salvar as alterações do serviço.');
            }

            fieldsToUpdate.forEach(({ row, field, input }) => {
                if (field === 'funcionario') {
                    row.dataset.fieldValue = input.value;
                    row.querySelector('span').textContent = input.selectedOptions[0].textContent;
                } else {
                    row.dataset.fieldValue = input.value;
                    const value = input.value;
                    row.querySelector('span').textContent = field === 'preco'
                        ? `R$ ${value}`
                        : field === 'duracao' ? `${value} min` : value;
                }
            });
            alterarModoEdicaoServico(card, false);
            return true;
        }

        function alterarModoEdicaoServico(card, editing, funcionarios = []) {

            card.querySelectorAll('[data-editable-field]').forEach(row => {

                const field = row.dataset.editableField;
                const currentValue = row.querySelector('input, select');

                if (editing) {
                    if (currentValue) return;
                    row.appendChild(criarCampoEdicao(row, field, funcionarios));
                    row.querySelector('span').hidden = true;
                    return;
                }

                if (currentValue) currentValue.remove();
                row.querySelector('span').hidden = false;
            });
        }

        function carregarInfo(section, entry) {
            const card = document.createElement('article');
            card.className = 'admin-entry';          

            if (section === 'servicos') {
                adicionarCampo(card, 'ID', entry.id);
                adicionarCampo(card, 'Serviço', entry.nome, 'nome');
                adicionarCampo(card, 'Atendente', entry.nome_funcionario, 'funcionario', entry.fk_funcionario);
                
                adicionarCampo(card, 'Preço', 
                entry.preco == null ? '' : `R$ ${entry.preco}`, 'preco', entry.preco);

                adicionarCampo(card, 'Duração', 
                entry.duracao == null ? '' : `${entry.duracao} min`, 'duracao', entry.duracao);
                
                adicionarCampo(card, 'Status', 
                entry.ativo === false || entry.ativo === 0 ? 'Inativo' : 'Ativo');
                
                const botaoEditar = adicionarBotao(card, 'Editar serviço', async () => {
                    const editing = botaoEditar.dataset.editing === 'true';
                    if (editing) {
                        alterarModoEdicaoServico(card, false);
                        botaoEditar.dataset.editing = 'false';
                        botaoEditar.textContent = 'Editar serviço';
                        botaoConcluir.hidden = true;
                        return;
                    }

                    try {
                        const funcionarios = await carregarFuncionarios();
                        alterarModoEdicaoServico(card, true, funcionarios);
                        botaoEditar.dataset.editing = 'true';
                        botaoEditar.textContent = 'Cancelar edição';
                        botaoConcluir.hidden = false;
                    } catch (error) {
                        alert(error.message || 'Não foi possível carregar os funcionários.');
                    }
                });
                const botaoConcluir = adicionarBotao(card, 'Concluir edição', async () => {
                    try {
                        if (!await concluirEdicaoServico(card, entry.id)) return;
                        botaoEditar.dataset.editing = 'false';
                        botaoEditar.textContent = 'Editar serviço';
                        botaoConcluir.hidden = true;
                    } catch (error) {
                        alert(error.message || 'Ocorreu um erro ao salvar o serviço.');
                    }
                });
                botaoConcluir.hidden = true;
                adicionarBotao(card,
                    entry.ativo === false || entry.ativo === 0? 'Ativar serviço' : 'Desativar serviço',
                    async ()=>{
                        const response = await fetch(`/servico/mudarstatus/${entry.id}`,{method:'PATCH'});
                        if(response.ok){
                            window.location.reload();
                            alert(`Status do serviço alterado!`)
                            return;
                        }

                        alert('Erro ao alterar o status do serviço')
                    }
                )

            } else if (section === 'funcionarios') {
                adicionarCampo(card,'ID', entry.id)

                adicionarCampo(card, 'Funcionário', entry.nome);
                adicionarCampo(card, 'Acesso', entry.acesso);

                const ativo = entry.ativo? 'ATIVO' : 'INATIVO'

                adicionarCampo(card, 'Status do funcionario', ativo);
                adicionarBotao(card,'Visualizar agendamentos', async()=>{
                    modalTitle.textContent = `Agendamentos de ${entry.nome}`;
                    modalBackdrop.hidden = false;
                    showMessage('Carregando agendamentos...');

                    try {
                        const response = await fetch(`/funcionario/agendamentos/${entry.id}`, { method: 'GET' });
                        const result = await response.json();
                        if (!response.ok) throw new Error(typeof result === 'string' ? result : 'Não foi possível carregar os agendamentos.');

                        if (!Array.isArray(result) || result.length === 0) {
                            showMessage('Este funcionário não possui agendamentos.');
                            return;
                        }

                        adminList.replaceChildren(...result.map(agendamento => carregarInfo('agendamentos', agendamento)));
                    } catch (error) {
                        showMessage(error.message || 'Ocorreu um erro ao carregar os agendamentos.');
                    }
                });
                adicionarBotao(card,'Visualizar serviços',async()=>{
                    modalTitle.textContent = `Serviços de ${entry.nome}`;
                    modalBackdrop.hidden = false;
                    showMessage('Carregando serviços...');

                    try{
                        const response = await fetch(`/funcionario/${entry.id}/servicos`, {method:'GET'});

                        const result = await response.json();
                        console.log(result)
                        if (!response.ok) throw new Error(typeof result === 'string' ? result : 'Não foi possível carregar os serviços.');

                        if (!Array.isArray(result) || result.length === 0) {
                            showMessage('Este funcionário não possui serviços atribuidos.');
                            return;
                        }

                        adminList.replaceChildren(...result.map(servico => carregarInfo('servicos', servico)));


                    }catch(e){if(e) throw e}
                });
                adicionarBotao(card,'Suspender funcionário', async()=>{});

            } else if (section === 'agendamentos') {
                adicionarCampo(card,'ID', entry.id)

                adicionarCampo(card, 'Serviço', entry.nome_servico);
                adicionarCampo(card, 'Funcionário', entry.nome_funcionario);
                adicionarCampo(card, 'Cliente', entry.nome_cliente);
                adicionarCampo(card, 'Horário', entry.horario || entry.hora);
                adicionarCampo(card, 'Status', entry.aStatus);

                adicionarBotao(card, 'Mudar status do agendamento');
                adicionarBotao(card, 'Gerenciar horários');
                adicionarBotao(card,'Mudar funcionario');
                
            } else if (section === 'clientes') {
                adicionarCampo(card,'ID', entry.id)

                adicionarCampo(card, 'Cliente', entry.nome);
                adicionarCampo(card, 'Telefone', entry.telefone);
                adicionarCampo(card, 'E-mail', entry.email);

                adicionarBotao(card,'Contatar cliente');
                adicionarBotao(card,'Visualizar agendamentos do cliente');
                adicionarBotao(card,'Banir cliente');

            }

            return card;
        }

        function showMessage(message) {
            const text = document.createElement('p');
            text.className = 'admin-message';
            text.textContent = message;
            adminList.replaceChildren(text);
        }

        async function loadSection(section) {
            const config = secoesAdmin[section];
            if (!config) return;

            modalTitle.textContent = config.title;
            modalBackdrop.hidden = false;
            showMessage('Carregando...');

            try {
                const response = await fetch(config.path, { method: 'GET' });
                if (!response.ok) throw new Error('Não foi possível carregar os dados.');

                const entries = await response.json();

                if (!Array.isArray(entries) || entries.length === 0) {
                    showMessage('Nenhum registro encontrado.');
                    return;
                }

                adminList.replaceChildren(...entries.map(entry => carregarInfo(section, entry)));
            } catch (error) {
                showMessage(error.message || 'Ocorreu um erro ao carregar os dados.');
            }
        }

        document.querySelectorAll('.admin-side-bar button[data-section]').forEach(button => {
            button.addEventListener('click', () => loadSection(button.dataset.section));
        });

        document.getElementById('admin-close').addEventListener('click', () => {
            modalBackdrop.hidden = true;
        });

        modalBackdrop.addEventListener('click', event => {
            if (event.target === modalBackdrop) modalBackdrop.hidden = true;
        });
    </script>
</body>
</html>