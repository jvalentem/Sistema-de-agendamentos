<%- include(partials + '/header-selector.ejs')%>

    <!--Visualizar seus próximos agendamentos.-->
    <!--Cancelar um agendamento dentro das regras definidas.-->

        <div id="detalhes-agendamento" hidden>
            <h1 id="details-nome-servico"></h1>
            <h2 id="details-nome-funcionario"></h2>
            <h2 id="details-horario"></h2>
            <button id="">Cancelar agendamento</button>
        </div>
        <section id="agendamentos">
            <h2>Seus agendamentos:</h2>
            <%if(userAgendamentos.length <= 0){%>
                <h2>Nenhum agendamento!</h2>
            <%}%>

            <%userAgendamentos.forEach(agendamento => {%>
                <div class="agendamento">
                    <h2><%= agendamento.servico.nome %></h2>
                    <h3>Preço: R$<%= agendamento.servico.preco%></h3>
                    
                    <button id="agendamento/detalhar/<%= agendamento.getId() %>">Detalhar agendamento</button>
                </div>
            <%})%>
        </section>
        <!--Consultar seu histórico de agendamentos.-->
        <section id="historico-agendamentos"></section>


        <script>
            const detalharAgendamentoButtons = document.querySelectorAll('.agendamento button');
            const detailsWindow = document.getElementById('detalhes-agendamento');

            function toggleDetailsWindow(){
                let isWindowActive = detailsWindow.hasAttribute('hidden')

                if(isWindowActive){
                    detailsWindow.removeAttribute('hidden');
                    return;
                }
                detailsWindow.setAttribute('hidden', '')
            }

            function defineDetailsWindow(details){
                // if(!detailsWindow.hasAttribute('hidden')) toggleDetailsWindow();
                console.log(details)
                let nomeServico = detailsWindow.querySelector('#details-nome-servico')
                let funcionario = detailsWindow.querySelector('#details-nome-funcionario')
                let horario = detailsWindow.querySelector('#details-horario')
                let botaoCancelarAgendamento = detailsWindow.querySelector('button');
                if(details){
                    const agendamentoId = details.id
                    console.log(details.servico)
                    nomeServico.textContent = `Nome do serviço: ${details.servico.nome}`
                    funcionario.textContent = `Atendente: ${details.servico.funcionario.nome}`
                    horario.textContent = `Horário: ${details.hora}`
                    botaoCancelarAgendamento.setAttribute('id',details.id)

                    botaoCancelarAgendamento.onclick = ()=>{
                        if(!window.confirm('Tem certeza que deseja cancelar esse agendamento?')) return
                        fetch(`/agendamento/detalhar/${agendamentoId}/cancelar`,{method:'DELETE'}).then(res=>{
                            if(!res.ok) return res.json().then(details => console.log(details));

                            window.location.reload()
                        })
                    }
                }
            }

            detalharAgendamentoButtons.forEach(b=>{
                const buttonId = b.getAttribute('id')
                const agendamentoId = buttonId.substring(buttonId.lastIndexOf('/')+1);

                function detalhar(){
                    fetch(`/agendamento/detalhar/${agendamentoId}`,{method:'GET'})
                    .then(res=> {
                        if(res.ok) return res.json()
                    })
                    .then(details => defineDetailsWindow(details))
                    .finally(toggleDetailsWindow());
                }
                
                b.onclick = ()=>{detalhar()}
            })
        </script>

<%- include(partials + '/footer.html')%>