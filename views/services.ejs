    <%- include('header-selector.ejs')%>

    <div>
        <h1>Serviços</h1>
        <div class="session">
            <h2>Sessão ativa: <%= session.acesso%></h2>
        </div>
    </div>
    
    <h3>Disponíveis:</h3>
    <%if(servicos.length > 0){%>
        <%servicos.forEach(servico =>{%>
            <div class="servico-box">
                <h4><%=servico.nome%></h4>
                <p>Atendente: <%=servico.funcionario.nome%></p>
                <p>R$<%=servico.preco%></p>
                <p>Duração aproximada: <%=servico.duracao%> min</p>
                <a href="/api/services/<%= servico.id %>/agendamento">Agendar</a> <!-- link padronizado para rota de agendamento -->
            </div>  
        <%})%>
    <%}%>
</body>
</html>