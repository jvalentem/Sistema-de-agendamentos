    <%- include(partials + "/header-selector.ejs")%>
    <main class="servico-container">
        <h1>Serviços</h1>
        <h3>Disponíveis:</h3>

        <%if(servicos.length > 0){%>
            <%servicos.forEach(servico =>{%>
                <div class="servico-card">
                    <div class="servico-info">
                        <h4><%=servico.nome%></h4>
                        <p>Atendente: <%=servico.funcionario.nome%></p>
                        <p>R$<%=servico.preco%></p>
                        <p>Duração aproximada: <%=servico.duracao%> min</p>
                    </div>

                    <div class="servico-actions">
                        <a class="servico-link" href="/servico/<%= servico.id %>">Agendar</a>
                    </div>
                </div>
            <%})%>
        <%}%>
    </main>
</body>
</html>