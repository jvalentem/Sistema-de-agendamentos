<%- include(partials + '/header-selector.ejs')%>

<main class="servico-container">
    <h2>Seus serviços:</h2>
    <div class="janela-flutuante" id="horarios" hidden>
        <div id="horarios-box">
        </div>
        
    </div>
    
    <%servicos.forEach(s =>{%>
        <div class="servico-card">
            <div class="servico-info">
                <h4><%=s.nome%></h4>
                <p>Atendente: Você</p>
                <p>Preço: R$<%=s.preco%></p>
                <p>Duração aproximada: <%=s.duracao%> min</p>
            </div>

            <div class="servico-actions">
                <button id=<%= "horarios-s" + s.id%> class="visualizar-horarios">Visualizar horários</button>
            </div>
        </div>
    <%})%>
</main>


<script>
    //Buttons
    const visualizarHorariosButtons = document.querySelectorAll('button.visualizar-horarios');   
    //Windows
    const horariosWindow = document.getElementById('horarios');
    
    //Essential Functions
    function toggleWindow(mode){

        //Se estiver no modo "view", o funcionario quer ver a tabela de horarios
        if(mode === 'view'){
            if(horariosWindow.hasAttribute('hidden')){
                horariosWindow.removeAttribute('hidden');
                return
            }
            horariosWindow.setAttribute('hidden','true');
            return
        }
        
    }
    
    
    function defineHorarios(horarios){
        if(!horarios) return false;
        horarios.forEach(h =>{
            const horarioDiv = document.createElement('div');

            const horarioText = document.createElement('p');
            const servicoId = h.fk_servico;
            
            horarioText.textContent = h.hora;
            horarioDiv.setAttribute('class','horario');
            horarioDiv.setAttribute('id',h.id);
            
           
            horarioDiv.appendChild(horarioText);            
            horariosWindow.appendChild(horarioDiv);
        })
        
    }

    //Event Listeneres
    visualizarHorariosButtons.forEach(b =>{
        b.onclick = async ()=>{
            let serviceId = b.getAttribute('id');
            serviceId = Number(serviceId.substring(serviceId.indexOf('-s')+2));
            
            if(!serviceId) return false;

            const path = `/servico/${serviceId}/horarios`
            const response = await fetch(path,{method:'GET'});
            
            const horarios = await response.json();

            defineHorarios(horarios)
            toggleWindow('view');
        
            //Voce deixou as janelas visiveis, e os horarios?
            //Criar um metodo define para a tela de horarios
            //e incluir o togglewindow
        }   
    })
    
</script>
</body>
</html>