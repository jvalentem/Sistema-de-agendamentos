<%- include(partials + '/header-selector.ejs')%>

<main class="servico-container">
    <h2>Seus serviços:</h2>
    <div class="admin-modal-backdrop" id="horarios" hidden aria-hidden="true">
        <section class="janela-flutuante admin-window" role="dialog" aria-modal="true" aria-labelledby="horarios-title">
            <div class="admin-window-header">
                <h2 id="horarios-title">Horários do serviço</h2>
                <button type="button" class="admin-close" id="horarios-close" aria-label="Fechar">&times;</button>
            </div>
            <div class="admin-list" id="horarios-box" aria-live="polite">
            </div>
        </section>
    </div>
    
    <%servicos.forEach(s =>{%>
        <div class="servico-card">
            <div class="servico-info">
                <h4><%=s.nome%></h4>
                <p>Atendente: Você</p>
                <p>Preço: R$<%=s.preco%></p>
                <p>Duração aproximada: <%=s.duracao%> min</p>
            </div>

            <div class="servico-actions">
                <button id=<%= "horarios-s" + s.id%> class="visualizar-horarios">Visualizar datas e horários</button>
            </div>
        </div>
    <%})%>
</main>


<script>
    //Buttons
    const visualizarHorariosButtons = document.querySelectorAll('button.visualizar-horarios');   
    //Windows
    const horariosWindow = document.getElementById('horarios');
    const horariosBox = document.getElementById('horarios-box');
    const horariosCloseButton = document.getElementById('horarios-close');

    function closeHorariosWindow(){
        horariosWindow.hidden = true;
        horariosWindow.setAttribute('aria-hidden', 'true');
    }

    function adicionarBloco(card, flex = null){
        if(!card) return false
        const bloco = document.createElement('div');

        if(flex) bloco.style.display = 'flex';

        card.appendChild(bloco);

        return bloco;

    }

    function adicionarTexto(card,label){
        if(!card || !label) return false;

        const row = document.createElement('p');
        row.textContent = label;

        card.appendChild(row);

        return row
    }

    function adicionarBotao(card,label,funct){
        if(!card || !label || !funct) return false;

        const button = document.createElement('button');
        button.textContent = label;

        button.onclick = funct;

        card.appendChild(button);

        return button
    }

    // let dateCache

    function previneRepeatedDates(vector){
        const formattedDateArray = []
        
        for(let v of vector){

            const dateExists = formattedDateArray.find(h => h.dataAgendamento == v.dataAgendamento)

            if(dateExists) continue; 

            formattedDateArray.push(v);
        }

        return formattedDateArray
    }

    function previneRepeatedHours(horarios){
        const formattedHourArray = []

        for(let h of horarios){
            const horarioExiste = formattedHourArray.find(hour => hour.hora == h.hora)
            if(horarioExiste) continue;

            formattedHourArray.push(h);
        }

        return formattedHourArray
    }

    function defineDatas(horario){
        horariosBox.replaceChildren();

        
        if(horario.length === 0){
            const emptyMessage = document.createElement('p');
            emptyMessage.className = 'admin-message';
            emptyMessage.textContent = 'Nenhum horário disponível para este serviço.';
            horariosBox.appendChild(emptyMessage);
            return;
        }



        previneRepeatedDates(horario).forEach(h =>{
            const bloco = adicionarBloco(horariosBox,true)
            const textoData = adicionarTexto(bloco,h.dataAgendamento)
            
            // dateCache = textoData.textContent;
            

            //Informando a data do agendamento (nesse caso do horario disponivel pra agendar)
            
            adicionarBotao(bloco,'Visualizar horários',async ()=>{

                try{
                    const response = await fetch(`/servico/${h.fk_servico}/data/${h.id}/horarios`,{method:'GET'});
                    if(!response.ok) throw new Error('Não foi possível carregar os horários.');

                    const horarios = await response.json();
                    if(!Array.isArray(horarios)) throw new Error('A resposta de horários é inválida.');

                    defineHorarios(previneRepeatedHours(horarios));
                }catch(error){alert(error.message || 'Não foi possível carregar os horários.')}
            })
        })

    }
    function defineHorarios(horarios){
        horariosBox.replaceChildren();

        if(horarios.length === 0){
            const emptyMessage = document.createElement('p');
            emptyMessage.className = 'admin-message';
            emptyMessage.textContent = 'Nenhum horário disponível nesta data.';
            horariosBox.appendChild(emptyMessage);
            return;
        }

        horarios.forEach(h =>{
            const horarioDiv = document.createElement('div');
            const horarioText = document.createElement('p');
            horarioText.textContent = h.hora;
            horarioDiv.setAttribute('class','horario');
            horarioDiv.setAttribute('id',h.id);
            horarioDiv.appendChild(horarioText);
            horariosBox.appendChild(horarioDiv);
        })
    }

    //Event Listeneres
    visualizarHorariosButtons.forEach(b =>{
        b.onclick = async ()=>{
            let serviceId = b.getAttribute('id');
            serviceId = Number(serviceId.substring(serviceId.indexOf('-s')+2));
            
            if(!serviceId) return false;

            try{
                const response = await fetch(`/servico/${serviceId}/datas`,{method:'GET'});
                if(!response.ok) throw new Error('Não foi possível carregar os horários!');
                const horarios = await response.json();

                if(!Array.isArray(horarios)) throw new Error('A resposta de horários é inválida.');

                defineDatas(horarios)

                horariosWindow.hidden = false;
                horariosWindow.setAttribute('aria-hidden', 'false');
            }catch(error){
                alert(error.message || 'Não foi possível carregar os horários.');
            }
        }   
    })

    horariosCloseButton.addEventListener('click', closeHorariosWindow);
    horariosWindow.addEventListener('click', event => {
        if(event.target === horariosWindow) closeHorariosWindow();
    });
    document.addEventListener('keydown', event => {
        if(event.key === 'Escape' && !horariosWindow.hidden) closeHorariosWindow();
    });
    
</script>
</body>
</html>