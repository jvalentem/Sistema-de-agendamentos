<%- include(partials + '/header-selector.ejs')%>

    <div id="detalhes-agendamento" class="admin-modal-backdrop" hidden aria-hidden="true">
        <section class="janela-flutuante admin-window" role="dialog" aria-modal="true" aria-labelledby="details-title">
            <div class="admin-window-header">
                <h2 id="details-title">Detalhes do agendamento</h2>
                <button type="button" class="admin-close" id="details-close" aria-label="Fechar">&times;</button>
            </div>
            <div class="admin-list">
                <div class="admin-entry" aria-live="polite">
                    <p><strong>Serviço:</strong> <span id="details-nome-servico"></span></p>
                    <p><strong>Atendente:</strong> <span id="details-nome-funcionario"></span></p>
                    <p><strong>Cliente:</strong> <span id="details-nome-cliente"></span></p>
                    <p><strong>Data:</strong> <span id="details-data"></span></p>
                    <p><strong>Horário:</strong> <span id="details-horario"></span></p>
                </div>
            </div>
        </section>
    </div>

        <main class="agenda-container">
            <h1>Sua Agenda:</h1>

            <%if(agendamentos.length <= 0){%>
                <p class="agenda-vazia">Nenhum agendamento no momento!</p>
            <%}%>

            <%agendamentos.forEach(a =>{%>
                <div class="agendamento">
                    <div class="agendamento-info">
                        <p><strong>Serviço:</strong> <%= a.nome_servico%></p>
                        <p><strong>Horário:</strong> <%= a.hora%></p>
                        <p><strong>Status:</strong> <%= a.aStatus%></p>
                    </div>

                    <div class="agendamento-actions">
                        <button id=<%= 'detalhar-' + a.id %> class="detalhar">Detalhar</button>

                        <%if(a.aStatus !== 'Cancelado'){%>
                            <button id=<%= 'cancelar-' + a.id%> class="cancelar">Cancelar</button>
                        <%}%>
                    </div>
                </div>
            <%})%>
        </main>


    <script>
        const cancelarButtons = document.querySelectorAll('button.cancelar');
        const detalharButtons = document.querySelectorAll('button.detalhar');
        const detailsWindow = document.getElementById('detalhes-agendamento');
        const detailsCloseButton = document.getElementById('details-close');

        function closeDetailsWindow(){
            detailsWindow.hidden = true;
            detailsWindow.setAttribute('aria-hidden', 'true');
        }

        function defineDetailsWindow(details){
            detailsWindow.querySelector('#details-nome-servico').textContent = details.nome_servico;
            detailsWindow.querySelector('#details-nome-funcionario').textContent = details.nome_funcionario;
            detailsWindow.querySelector('#details-nome-cliente').textContent = details.nome_cliente;
            detailsWindow.querySelector('#details-data').textContent = details.dataAgendamento
            detailsWindow.querySelector('#details-horario').textContent = details.horario;
        }

        function requestCancelling(id){
            if(!id) return false;
            fetch(`/agendamento/detalhar/${id}/cancelar`,{method:'DELETE'})
            .then(res=>{
                if(res.ok){
                    window.location.reload();
                    return alert('Agendamento cancelado com sucesso!')
                }
            
            }).catch(e =>{alert('Nao foi possivel apagar o agendamento')})
        }

        async function requestDetails(id){
            if(!id) return;
            try{
                const response = await fetch(`/agendamento/detalhar/${id}`,{method:'GET'});
                if(!response.ok) throw new Error('Ocorreu um erro ao detalhar o agendamento!');
                const details = await response.json();
                defineDetailsWindow(details)
                detailsWindow.hidden = false;
                detailsWindow.setAttribute('aria-hidden', 'false');
            }catch(error){
                alert(error.message || 'Ocorreu um erro ao detalhar o agendamento!');
            }
        }

        detailsCloseButton.addEventListener('click', closeDetailsWindow);
        detailsWindow.addEventListener('click', event => {
            if(event.target === detailsWindow) closeDetailsWindow();
        });
        document.addEventListener('keydown', event => {
            if(event.key === 'Escape' && !detailsWindow.hidden) closeDetailsWindow();
        });


        cancelarButtons.forEach(b => {
            let agendamentoId = b.getAttribute('id');
            agendamentoId = agendamentoId.substring(9)
            
            b.onclick = ()=>{requestCancelling(agendamentoId)}
        })
        
        detalharButtons.forEach(b => {
            let agendamentoId = b.getAttribute('id');
            agendamentoId = agendamentoId.substring(9)

            b.onclick = ()=>{requestDetails(agendamentoId)}
        })
    </script>
    </body>
</html>