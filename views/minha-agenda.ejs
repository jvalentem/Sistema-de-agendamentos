<%- include(partials + '/header-selector.ejs')%>

    <div id="detalhes-agendamento" class="janela-flutuante" hidden>
            <h1 id="details-nome-servico"></h1>
            <h2 id="details-nome-funcionario"></h2>
            <h2 id="details-nome-cliente"></h2>
            <h2 id="details-horario"></h2>
        </div>
        <h1>Sua Agenda:</h1>
        <%if(agendamentosCompletos.length <= 0){%>
            <p>Nenhum agendamento no momento!</p>
        <%}%>
    <%agendamentosCompletos.forEach(a =>{%>
        <div class="agendamento">
            <p>Serviço: <%= a.servico.nome%></p>
            <p>Horário: <%= a.hora%></p>
            <p>Status: <%= a.aStatus%></p>
            <button id=<%= 'detalhar-' + a.id %> class="detalhar">Detalhar</button>

            <%if(a.status !== 'Cancelado'){%>
                <button id=<%= 'cancelar-' + a.id%> class="cancelar">Cancelar</button>
            <%}%>
        </div>    
    <%})%>


    <script>
        const cancelarButtons = document.querySelectorAll('button.cancelar');
        const detalharButtons = document.querySelectorAll('button.detalhar');
        const detailsWindow = document.getElementById('detalhes-agendamento')


         function toggleDetailsWindow(){
                let isWindowActive = detailsWindow.hasAttribute('hidden')

                if(isWindowActive){
                    detailsWindow.removeAttribute('hidden');
                    return;
                }
                detailsWindow.setAttribute('hidden', '')
            }

            function defineDetailsWindow(details){
                // if(!detailsWindow.hasAttribute('hidden')) toggleDetailsWindow();

                let nomeServico = detailsWindow.querySelector('#details-nome-servico')
                let funcionario = detailsWindow.querySelector('#details-nome-funcionario')
                let horario = detailsWindow.querySelector('#details-horario')
                let cliente = detailsWindow.querySelector('#details-nome-cliente')

                if(details){

                    const agendamentoId = details.id
                    nomeServico.textContent = `Nome do serviço: ${details.nome_servico}`
                    funcionario.textContent = `Atendente: ${details.nome_funcionario}`
                    horario.textContent = `Horário: ${details.hora}`
                    cliente.textContent = `Cliente: ${details.nome_cliente}`
                }
            }

        function requestCancelling(id){
            if(!id) return false;
            fetch(`/agendamento/detalhar/${id}/cancelar`,{method:'DELETE'})
            .then(res=>{
                if(res.ok){
                    window.location.reload();
                    return alert('Agendamento apagado com sucesso!')
                }
            
            }).catch(e =>{alert('Nao foi possivel apagar o agendamento')})
        }

        function requestDetails(id){
            if(!id) return false;
            fetch(`/agendamento/detalhar/${id}`,{method:'GET'}).then(res=>{
                if(res.ok) return res.json()
                alert('Ocorreu um erro ao detalhar o agendamento!')
            }).then(details =>{
                defineDetailsWindow(details)
                toggleDetailsWindow()
            })
        }



        cancelarButtons.forEach(b => {
            let agendamentoId = b.getAttribute('id');
            agendamentoId = agendamentoId.substring(9)
            
            b.onclick = ()=>{requestCancelling(agendamentoId)}
        })
        
        detalharButtons.forEach(b => {
            let agendamentoId = b.getAttribute('id');
            agendamentoId = agendamentoId.substring(9)

            b.onclick = ()=>{requestDetails(agendamentoId)}
        })
    </script>
    </body>
</html>